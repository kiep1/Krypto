PORT=3000
NODE_ENV=development
APP_ORIGIN=https://www.candletutor.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Durable PostgreSQL connection string. Use Render's internal URL for a same-region Render web service.
DATABASE_URL=
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Google Cloud OAuth web client. Add this exact authorized redirect URI:
# https://www.candletutor.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://www.candletutor.com/auth/google/callback

# SMTP is required for email registration verification and password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Set to the key stored in the separately delivered Krypto-premium-content-key.txt file.
PREMIUM_CONTENT_KEY=

# Stripe live subscription payment link and account credentials.
STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/aFabJ1gcMdvv8AY7lGfnO01
STRIPE_PAYMENT_LINK_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
